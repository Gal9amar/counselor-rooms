# Supabase - Transaction Pooler (port 6543) - used by Prisma at runtime
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase - Direct connection (port 5432) - used by Prisma for migrations
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Admin panel password
ADMIN_PASSWORD="your-admin-password-here"

# Booking-request notification emails (Resend). Set these in Netlify env vars too.
RESEND_API_KEY="re_xxx"
# Optional: recipient (default gal9amar@gmail.com) and sender (must be on a verified Resend domain
# to send to anyone other than the Resend account owner; default onboarding@resend.dev)
BOOKING_NOTIFY_EMAIL="gal9amar@gmail.com"
RESEND_FROM="מרכז אופק - בקשות שיבוץ <requests@hamanulan.com>"
SITE_URL="https://treatmentrooms.netlify.app"
